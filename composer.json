{
    "name": "nataphp/backup",
    "description": "Daily backups for NataPHP apps: MySQL dump and folder archives, local retention and an external copy over rsync/ssh",
    "type": "nataphp-plugin",
    "license": "MIT",
    "homepage": "https://github.com/nataphp/backup",
    "authors": [
        {
            "name": "Sérgio Dinis Lopes",
            "homepage": "https://github.com/sergiodlopes"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-phar": "*",
        "ext-zlib": "*",
        "nataphp/core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Backup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Backup\\Test\\": "tests/"
        }
    },
    "extra": {
        "nataphp": {
            "bootstrap": false,
            "routes": false
        }
    }
}
